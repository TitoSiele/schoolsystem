# Copy to .env and fill in. NEVER commit the real .env file.
#
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Session security - REQUIRED. Without this the server refuses to start.
# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# ---------------------------------------------------------------------------
SCHOOLPAY_SECRET=

# ---------------------------------------------------------------------------
# M-Pesa Daraja (Safaricom M-PESA Express)
# Get these from https://developer.safaricom.co.ke/portal/register
# Leave MPESA_SANDBOX=true while testing - sandbox never moves real money.
# ---------------------------------------------------------------------------
MPESA_SANDBOX=true
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSCODE=
# Must be a public HTTPS URL Safaricom can reach.
MPESA_CALLBACK_URL=

# ---------------------------------------------------------------------------
# Shared secret used to verify payment webhook signatures.
# ---------------------------------------------------------------------------
PAYMENT_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Development test accounts. Only used by the scripts in backend/tests/.
# ---------------------------------------------------------------------------
SCHOOLPAY_TEST_PASSWORD=
SCHOOLPAY_TEST_ACME_PASSWORD=
PLATFORM_ADMIN_PASSWORD=
SCHOOLPAY_BASE_URL=http://127.0.0.1:8000
